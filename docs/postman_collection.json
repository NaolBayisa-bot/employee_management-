{
  "info": {
    "name": "TaskApp Backend API",
    "_exporter_id": "taskapp-backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@company.com\",\"password\":\"ChangeMe123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has adminToken', () => pm.environment.set('adminToken', pm.response.json().token));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Register Manager",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Manager User\",\"email\":\"mgr_{{$timestamp}}@test.com\",\"password\":\"Test123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Saves pendingUserId', () => { pm.environment.set('pendingUserId', pm.response.json().user.id); pm.environment.set('managerEmail', pm.response.json().user.email); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Register Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Employee User\",\"email\":\"emp_{{$timestamp}}@test.com\",\"password\":\"Test123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Saves pendingEmployeeId', () => pm.environment.set('pendingEmployeeId', pm.response.json().user.id));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. List Pending Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/users?status=PENDING"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has users array', () => pm.expect(pm.response.json().users).to.be.an('array'));",
              "pm.test('At least 2 pending', () => pm.expect(pm.response.json().users.length).to.be.at.least(2));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5a. Approve Manager",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/{{pendingUserId}}/approve",
        "body": {
          "mode": "raw",
          "raw": "{\"role\":\"MANAGER\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Manager ACTIVE', () => pm.expect(pm.response.json().user.status).to.eql('ACTIVE'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
